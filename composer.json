{
	"name": "galatanovidiu/charter",
	"description": "Provides a secure, standards-compliant OAuth 2.1 authorization server for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Ovidiu Galatan",
			"homepage": "https://github.com/galatanovidiu"
		}
	],
	"require": {
		"php": ">=8.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4",
		"wp-cli/dist-archive-command": "3.1.0",
		"wp-cli/wp-cli": "^2.12",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"GalatanOvidiu\\Charter\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GalatanOvidiu\\Charter\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.4.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml.dist",
		"format": "phpcbf --standard=phpcs.xml.dist",
		"analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
		"test:unit": "phpunit --configuration=phpunit.xml.dist --bootstrap=tests/bootstrap-unit.php --testsuite=unit",
		"test": "@test:unit",
		"check": [
			"composer validate --strict",
			"composer audit --locked",
			"@lint",
			"@analyse",
			"@test:unit"
		]
	}
}
