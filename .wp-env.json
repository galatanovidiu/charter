{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.4",
	"testsEnvironment": false,
	"autoPort": true,
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEVELOPMENT_MODE": "plugin"
	},
	"mappings": {
		"wp-content/plugins/charter": "."
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp plugin activate charter"
	}
}
