<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
	colors="true"
	beStrictAboutChangesToGlobalState="true"
	beStrictAboutOutputDuringTests="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	cacheResultFile="tests/_output/.phpunit.result.cache"
	failOnRisky="true"
	failOnWarning="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/Unit</directory>
		</testsuite>
		<testsuite name="integration">
			<file>tests/Integration/PluginBootstrapTest.php</file>
			<directory suffix="Test.php">tests/Integration/OAuth</directory>
		</testsuite>
		<testsuite name="slice0-multisite">
			<file>tests/Integration/PluginBootstrapTest.php</file>
			<directory suffix="Test.php">tests/Integration/Multisite</directory>
		</testsuite>
		<testsuite name="slice0-atomic">
			<directory suffix="Test.php">tests/Integration/AtomicLifecycle</directory>
		</testsuite>
		<testsuite name="slice0-rest-auth">
			<directory suffix="Test.php">tests/Integration/RestAuthenticationBoundary</directory>
		</testsuite>
		<testsuite name="slice0-discovery-publication">
			<directory suffix="Test.php">tests/Integration/DiscoveryPublication</directory>
			<exclude>tests/Integration/DiscoveryPublication/UnsupportedTopologyWordPressTest.php</exclude>
			<exclude>tests/Integration/DiscoveryPublication/UnsupportedPathMultisiteHttpTest.php</exclude>
		</testsuite>
		<testsuite name="slice0-discovery-publication-wordpress-single">
			<file>tests/Integration/DiscoveryPublication/UnsupportedTopologyWordPressTest.php</file>
		</testsuite>
		<testsuite name="slice0-discovery-publication-wordpress-multisite">
			<file>tests/Integration/DiscoveryPublication/UnsupportedPathMultisiteHttpTest.php</file>
		</testsuite>
	</testsuites>
</phpunit>
