{
	"name": "charter",
	"version": "0.1.0",
	"private": true,
	"description": "Development and release tooling for the Charter WordPress plugin.",
	"engines": {
		"node": ">=24.18.0 <25",
		"npm": ">=11.16.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"build:admin": "webpack --mode=production",
		"start:admin": "webpack --mode=development --watch",
		"env:start": "wp-env start --auto-port",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env cleanup",
		"postinstall": "node tools/patch-wp-env.cjs",
		"test:javascript": "node --test tests/JavaScript/*.test.mjs",
		"test:integration:start": "wp-env start --config=.wp-env.test.json --auto-port",
		"test:integration": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/charter php vendor/bin/phpunit --configuration=phpunit.xml.dist --bootstrap=tests/bootstrap-integration.php --testsuite=integration",
		"test:integration:logs": "wp-env logs --config=.wp-env.test.json --no-watch",
		"test:integration:stop": "wp-env stop --config=.wp-env.test.json",
		"test:integration:ci": "bash tools/run-integration-tests.sh",
		"test:oauth:http:ci": "bash tools/run-oauth-http-tests.sh",
		"test:slice0:multisite:start": "wp-env start --config=.wp-env.slice0.json --auto-port",
		"test:slice0:multisite:prepare": "wp-env run cli --config=.wp-env.slice0.json bash -c 'for constant in MULTISITE SUBDOMAIN_INSTALL DOMAIN_CURRENT_SITE PATH_CURRENT_SITE SITE_ID_CURRENT_SITE BLOG_ID_CURRENT_SITE; do wp config delete \"$constant\" --config-file=/wordpress-phpunit/wp-tests-config.php; done'",
		"test:slice0:multisite:version": "wp-env run cli --config=.wp-env.slice0.json wp core version",
		"test:slice0:multisite": "wp-env run cli --config=.wp-env.slice0.json --env-cwd=wp-content/plugins/charter env WP_MULTISITE=1 php vendor/bin/phpunit --configuration=phpunit.xml.dist --bootstrap=tests/bootstrap-integration.php --testsuite=slice0-multisite",
		"test:slice0:root-key": "wp-env run cli --config=.wp-env.slice0.json --env-cwd=wp-content/plugins/charter bash tools/run-slice0-root-key-probes.sh",
		"test:slice0:multisite:logs": "wp-env logs --config=.wp-env.slice0.json --no-watch",
		"test:slice0:multisite:destroy": "wp-env destroy --config=.wp-env.slice0.json --force",
		"test:slice0:multisite:ci": "bash tools/run-slice0-multisite-tests.sh",
		"test:network-admin:http:ci": "bash tools/run-network-admin-http-tests.sh",
		"test:slice0:rest-auth": "wp-env run cli --config=.wp-env.slice0.json --env-cwd=wp-content/plugins/charter env WP_MULTISITE=1 CHARTER_SKIP_PRODUCTION_PLUGIN=1 php vendor/bin/phpunit --configuration=phpunit.xml.dist --bootstrap=tests/bootstrap-integration.php --testsuite=slice0-rest-auth",
		"test:slice0:rest-auth:process": "bash tools/run-slice0-rest-authentication.sh process",
		"test:slice0:rest-auth:http": "bash tools/run-slice0-rest-authentication.sh http",
		"test:slice0:rest-auth:ci": "bash tools/run-slice0-rest-authentication-tests.sh",
		"test:slice0:discovery-publication": "php vendor/bin/phpunit --configuration=phpunit.xml.dist --bootstrap=tests/bootstrap-unit.php --testsuite=slice0-discovery-publication",
		"test:slice0:discovery-publication:wordpress:single": "wp-env run cli --config=.wp-env.slice0.json --env-cwd=wp-content/plugins/charter php vendor/bin/phpunit --configuration=phpunit.xml.dist --bootstrap=tests/bootstrap-integration.php --testsuite=slice0-discovery-publication-wordpress-single",
		"test:slice0:discovery-publication:wordpress:multisite": "wp-env run cli --config=.wp-env.slice0.json --env-cwd=wp-content/plugins/charter env WP_MULTISITE=1 php vendor/bin/phpunit --configuration=phpunit.xml.dist --bootstrap=tests/bootstrap-integration.php --testsuite=slice0-discovery-publication-wordpress-multisite",
		"test:slice0:discovery-publication:wp-cli": "wp-env run cli --config=.wp-env.slice0.json wp charter-slice0 topology --canonical-base=https://path-network.charter.test/team",
		"test:slice0:discovery-publication:matrix": "bash tools/run-slice0-discovery-publication.sh",
		"test:slice0:discovery-publication:ci": "bash tools/run-slice0-discovery-publication-tests.sh",
		"test:slice0:atomic:matrix": "bash tools/run-slice0-atomic-lifecycle.sh",
		"test:slice0:atomic:stress": "CHARTER_ATOMIC_ROUNDS=75 bash tools/run-slice0-atomic-lifecycle.sh",
		"test:slice0:cimd-outbound-safety": "php vendor/bin/phpunit --configuration=phpunit.xml.dist --bootstrap=tests/bootstrap-unit.php --exclude-group=p3-hostile tests/Integration/CimdOutboundSafety",
		"test:slice0:cimd-outbound-safety:ci": "bash tools/run-slice0-cimd-outbound-safety.sh",
		"build:zip": "npm run build:admin && bash tools/build-zip.sh",
		"artifact:verify": "php tools/verify-archive.php build/charter.zip",
		"artifact:allowlist": "bash tools/test-artifact-allowlist.sh",
		"artifact:reproducible": "bash tools/test-reproducible-artifact.sh",
		"artifact:test": "bash tools/test-archive.sh",
		"secret:check": "bash tools/check-secret-safety.sh",
		"audit": "npm audit --audit-level=high",
		"format": "prettier --no-error-on-unmatched-pattern --write \".github/**/*.{yml,yaml}\" \"assets/**/*.js\" \"tests/JavaScript/**/*.mjs\" \".wp-env*.json\" \"*.json\" \"*.md\" \"docs/**/*.md\" \"webpack.config.js\"",
		"format:check": "prettier --no-error-on-unmatched-pattern --check \".github/**/*.{yml,yaml}\" \"assets/**/*.js\" \"tests/JavaScript/**/*.mjs\" \".wp-env*.json\" \"*.json\" \"*.md\" \"docs/**/*.md\" \"webpack.config.js\""
	},
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/preset-env": "^8.0.7",
		"@babel/preset-react": "^8.0.1",
		"@wordpress/env": "^11.12.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^6.57.0",
		"@wordpress/prettier-config": "^4.57.0",
		"babel-loader": "^10.1.1",
		"prettier": "^3.9.10",
		"webpack": "^5.112.0",
		"webpack-cli": "^7.2.3"
	},
	"overrides": {
		"@simple-git/argv-parser": "2.0.1",
		"adm-zip": "0.6.1",
		"qs": "6.16.1",
		"rimraf": "6.1.3",
		"simple-git": "4.0.2"
	}
}
